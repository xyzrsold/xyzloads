# Для запуска у себя на компьютере: скопируйте этот файл в ".env" (без .example).
# На Bothost файл .env не нужен — эти значения вносятся в панели в разделе «Переменные окружения».

# Токен бота от @BotFather. На Bothost подставляется автоматически, вносить не нужно.
BOT_TOKEN=

# Токен Яндекс Музыки (нужен только для ссылок на Яндекс Музыку)
YANDEX_TOKEN=

# Кому можно пользоваться ботом: id пользователей через запятую (ваш и модераторов).
# Пусто — тогда ботом сможет пользоваться кто угодно.
ALLOWED_USERS=

# Необязательно: путь к cookies.txt для YouTube. На Bothost: загрузите файл в папку data
# через файловый менеджер и укажите /app/data/cookies.txt
YT_COOKIES=

# Лимит размера файла в МБ (у обычного Telegram Bot API — 50)
MAX_FILE_MB=50

# Сколько скачиваний одновременно. На бесплатном тарифе (256 МБ памяти) лучше 1
MAX_PARALLEL=2
